generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────── RBAC ───────────

model User {
  id           Int       @id @default(autoincrement()) @map("user_id")
  employeeId   Int?      @unique @map("employee_id")
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  status       String    @default("active") @db.VarChar(20)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee Employee?  @relation(fields: [employeeId], references: [id])
  roles    UserRole[]

  @@map("users")
}

model Role {
  id          Int     @id @default(autoincrement()) @map("role_id")
  name        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int     @id @default(autoincrement()) @map("permission_id")
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────── Organization ───────────
// Client companies that outsourced staff are deployed to (BBK, BNP Paribas, Ithmaar...)
model ClientCompany {
  id              Int      @id @default(autoincrement()) @map("client_company_id")
  name            String   @unique @db.VarChar(150)
  nameAr          String?  @map("name_ar") @db.VarChar(150)
  annualLeaveDays Int      @map("annual_leave_days")   // replaces the company's annual leave for staff deployed here
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  employees Employee[]

  @@map("client_companies")
}

model Department {
  id        Int      @id @default(autoincrement()) @map("department_id")
  name      String   @unique @db.VarChar(100)
  managerId Int?     @map("manager_id")
  createdAt DateTime @default(now()) @map("created_at")

  manager   Employee?  @relation("DepartmentManager", fields: [managerId], references: [id])
  employees Employee[] @relation("DepartmentEmployees")

  @@map("departments")
}

model Employee {
  id             Int       @id @default(autoincrement()) @map("employee_id")
  employeeCode   String    @unique @map("employee_code") @db.VarChar(20)
  firstName      String    @map("first_name") @db.VarChar(50)
  lastName       String    @map("last_name") @db.VarChar(50)
  email          String    @unique @db.VarChar(100)
  phone          String?   @db.VarChar(20)
  address        String?   @db.VarChar(255)
  gender         String?   @db.VarChar(10)
  birthDate      DateTime? @map("birth_date") @db.Date
  nationality    String?   @db.VarChar(50)
  cprNumber      String?   @unique @map("cpr_number") @db.VarChar(20)
  photoUrl       String?   @map("photo_url") @db.VarChar(255)

  departmentId   Int?      @map("department_id")
  clientCompany      ClientCompany? @relation(fields: [clientCompanyId], references: [id])
  jobTitle       String?   @map("job_title") @db.VarChar(100)
  managerId      Int?      @map("manager_id")
  employmentType String?   @map("employment_type") @db.VarChar(30)
  workLocation   String?   @map("work_location") @db.VarChar(100)
  hireDate       DateTime? @map("hire_date") @db.Date
  probationEnd   DateTime? @map("probation_end") @db.Date
  status         String    @default("active") @db.VarChar(20)
  country        String    @default("BH") @db.VarChar(2)
  isNational     Boolean   @default(false) @map("is_national")    // Bahraini in BH / Saudi in SA -> pension contributions
  siNewScheme    Boolean   @default(false) @map("si_new_scheme")  // Saudi: first GOSI registration on/after 3 July 2024

  // outsourced staff 
  clientCompanyId  Int?      @map("client_company_id")
  clientSupervisor String?   @map("client_supervisor") @db.VarChar(150)
  poNumber         String?   @map("po_number") @db.VarChar(50)
  deploymentStart  DateTime? @map("deployment_start") @db.Date
  deploymentEnd    DateTime? @map("deployment_end") @db.Date
  bankName          String? @map("bank_name") @db.VarChar(100)
  bankAccountNumber String? @map("bank_account_number") @db.VarChar(255)

  emergencyName  String?   @map("emergency_contact_name") @db.VarChar(100)
  emergencyPhone String?   @map("emergency_contact_phone") @db.VarChar(20)

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  department         Department?  @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  managedDepartments Department[] @relation("DepartmentManager")
  manager            Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports      Employee[]   @relation("EmployeeManager")
  user               User?
  leaveRequests      LeaveRequest[]
  documents          Document[]
  contracts          Contract[]
  payItems           PayItem[]
  payslips           Payslip[]
  requests           EmployeeRequest[]

  @@map("employees")
}

// ─────────── Audit ───────────

model AuditLog {
  id          Int      @id @default(autoincrement()) @map("audit_id")
  actorUserId Int?     @map("actor_user_id")
  action      String   @db.VarChar(50)
  entity      String   @db.VarChar(50)
  entityId    String   @map("entity_id") @db.VarChar(50)
  changes     Json?
  ip          String?  @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ─────────── Leave ───────────

model LeaveType {
  id                 Int     @id @default(autoincrement()) @map("leave_type_id")
  country            String  @db.VarChar(2)                    // BH | SA
  code               String  @db.VarChar(30)                   // ANNUAL, SICK, MATERNITY...
  name               String  @db.VarChar(100)
  description        String? @db.VarChar(255)
  allowance          String  @db.VarChar(10)                   // "yearly" (balance per year) | "per_event"
  days               Int                                       // days per year, or per event
  daysAfterYears     Int?    @map("days_after_years")          // e.g. 5  (Saudi: 30 days after 5 years)
  daysAfter          Int?    @map("days_after")                // e.g. 30
  accrueFirstYear    Boolean @default(false) @map("accrue_first_year") // Bahrain: 2.5 days/month in year 1
  payTiers           Json?   @map("pay_tiers")                 // [{"days":15,"payPercent":100},...]; null = fully paid
  minServiceMonths   Int     @default(0) @map("min_service_months")
  gender             String? @db.VarChar(10)                   // Male | Female | null = everyone
  oncePerEmployment  Boolean @default(false) @map("once_per_employment")
  requiresAttachment Boolean @default(false) @map("requires_attachment")
  countWorkingDays   Boolean @default(false) @map("count_working_days") // skip Fri/Sat + public holidays
    noticeFreeDays     Int     @default(0) @map("notice_free_days")  // requests up to this many days need no notice
  noticeDays         Int?    @map("notice_days")                  // longer requests need this many days' notice
  active             Boolean @default(true)

  requests LeaveRequest[]

  @@unique([country, code])
  @@map("leave_types")
}

model LeaveRequest {
  id            Int      @id @default(autoincrement()) @map("leave_request_id")
  employeeId    Int      @map("employee_id")
  leaveTypeId   Int      @map("leave_type_id")
  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime @map("end_date") @db.Date
  days          Int
  reason        String?  @db.VarChar(500)
  attachmentId  Int?     @map("attachment_id")
  status        String   @default("pending_manager") @db.VarChar(20) // pending_manager | pending_hr | approved | rejected | cancelled
  payBreakdown  Json?    @map("pay_breakdown")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employee   Employee        @relation(fields: [employeeId], references: [id])
  leaveType  LeaveType       @relation(fields: [leaveTypeId], references: [id])
  attachment Document?       @relation(fields: [attachmentId], references: [id])
  approvals  LeaveApproval[]

  @@index([employeeId, status])
  @@index([status])
  @@map("leave_requests")
}

model LeaveApproval {
  id             Int      @id @default(autoincrement()) @map("leave_approval_id")
  requestId      Int      @map("leave_request_id")
  stage          String   @db.VarChar(20) // manager | hr
  decision       String   @db.VarChar(20) // approved | rejected
  comment        String?  @db.VarChar(500)
  approverUserId Int      @map("approver_user_id")
  approverName   String   @map("approver_name") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")

  request LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("leave_approvals")
}

model PublicHoliday {
  id      Int      @id @default(autoincrement()) @map("holiday_id")
  country String   @db.VarChar(2)
  date    DateTime @db.Date
  name    String   @db.VarChar(100)

  @@unique([country, date])
  @@map("public_holidays")
}

// ─────────── Documents / uploads ───────────

model Document {
  id                Int       @id @default(autoincrement()) @map("document_id")
  employeeId        Int       @map("employee_id")
  category          String    @db.VarChar(30)                      // leave_attachment | id_copy | certificate | contract | personal | other
  title             String    @db.VarChar(150)
  originalName      String    @map("original_name") @db.VarChar(255)
  storedName        String    @unique @map("stored_name") @db.VarChar(100) // random name on disk
  mimeType          String    @map("mime_type") @db.VarChar(50)
  size              Int                                            // bytes
  expiryDate        DateTime? @map("expiry_date") @db.Date         // e.g. passport / CPR copy
  visibleToEmployee Boolean   @default(true) @map("visible_to_employee")
  notes             String?   @db.VarChar(500)
  uploadedByUserId  Int       @map("uploaded_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  deletedAt         DateTime? @map("deleted_at")                   // soft delete (file kept for retention)

  employee           Employee          @relation(fields: [employeeId], references: [id])
  leaveRequests      LeaveRequest[]
  contracts          Contract[]
  requestAttachments EmployeeRequest[] @relation("RequestAttachment")
  requestResults     EmployeeRequest[] @relation("RequestResult")

  @@index([employeeId, category])
  @@index([expiryDate])
  @@map("documents")
}

// ─────────── Contracts ───────────

model Contract {
  id                 Int       @id @default(autoincrement()) @map("contract_id")
  employeeId         Int       @map("employee_id")
  contractNumber     String?   @unique @map("contract_number") @db.VarChar(20) // CT-2026-0001 (null on rows created before this column)
  contractType       String    @map("contract_type") @db.VarChar(20)   // unlimited | limited
  jobTitle           String?   @map("job_title") @db.VarChar(100)
  weeklyHours        Int?      @map("weekly_hours")
  startDate          DateTime  @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date               // null for unlimited
  basicSalary        Decimal   @map("basic_salary") @db.Decimal(12, 3)
  housingAllowance   Decimal   @default(0) @map("housing_allowance") @db.Decimal(12, 3)
  transportAllowance Decimal   @default(0) @map("transport_allowance") @db.Decimal(12, 3)
  currency           String    @db.VarChar(3)                          // BHD | SAR
  status             String    @default("active") @db.VarChar(20)      // active | renewed | expired | terminated
  documentId         Int?      @map("document_id")                     // signed contract PDF
  notes              String?   @db.VarChar(500)
  createdByUserId    Int       @map("created_by_user_id")
  createdAt          DateTime  @default(now()) @map("created_at")

  employee Employee  @relation(fields: [employeeId], references: [id])
  document Document? @relation(fields: [documentId], references: [id])
  payslips Payslip[]

  @@index([employeeId, status])
  @@index([endDate])
  @@map("contracts")
}

// ─────────── Payroll ───────────

model PayItemType {
  id           Int     @id @default(autoincrement()) @map("pay_item_type_id")
  code         String  @unique @db.VarChar(30)       // BONUS, OVERTIME, LOAN...
  name         String  @db.VarChar(100)
  kind         String  @db.VarChar(10)               // earning | deduction
  contributory Boolean @default(false)               // counts toward the social insurance base
  active       Boolean @default(true)

  items PayItem[]

  @@map("pay_item_types")
}

model PayItem {
  id               Int       @id @default(autoincrement()) @map("pay_item_id")
  employeeId       Int       @map("employee_id")
  typeId           Int       @map("type_id")
  amount           Decimal   @db.Decimal(12, 3)
  recurring        Boolean   @default(false)
  fromPeriod       String    @map("from_period") @db.VarChar(7)   // "2026-11"
  toPeriod         String?   @map("to_period") @db.VarChar(7)     // recurring end (null = open); one-time = fromPeriod
  reason           String?   @db.VarChar(255)
  status           String    @default("pending") @db.VarChar(20)  // pending | approved | rejected
  createdByUserId  Int       @map("created_by_user_id")
  approvedByUserId Int?      @map("approved_by_user_id")
  approvedAt       DateTime? @map("approved_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  employee Employee    @relation(fields: [employeeId], references: [id])
  type     PayItemType @relation(fields: [typeId], references: [id])

  @@index([employeeId, status])
  @@map("pay_items")
}

model PayrollRun {
  id               Int       @id @default(autoincrement()) @map("payroll_run_id")
  period           String    @db.VarChar(7)                       // "2026-11"
  entity           String    @default("BH") @db.VarChar(2)        
  status           String    @default("draft") @db.VarChar(20)    
  warnings         Json?                                          // employees skipped / needing review
  createdByUserId  Int       @map("created_by_user_id")
  approvedByUserId Int?      @map("approved_by_user_id")
  approvedAt       DateTime? @map("approved_at")
  processedAt      DateTime? @map("processed_at")
  paidAt           DateTime? @map("paid_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  payslips Payslip[]

  @@unique([period, entity])
  @@map("payroll_runs")
}

// One row per employee per run - a snapshot that never changes once processed (BR-4.8)
model Payslip {
  id                    Int      @id @default(autoincrement()) @map("payslip_id")
  runId                 Int      @map("payroll_run_id")
  employeeId            Int      @map("employee_id")
  contractId            Int      @map("contract_id")
  employeeCode          String   @map("employee_code") @db.VarChar(20)
  employeeName          String   @map("employee_name") @db.VarChar(110)
  department            String?  @db.VarChar(100)
  jobTitle              String?  @map("job_title") @db.VarChar(100)
  country               String   @db.VarChar(2)
  currency              String   @db.VarChar(3)
  basicSalary           Decimal  @map("basic_salary") @db.Decimal(12, 3)
  earnings              Json                                         // [{code,name,amount,source,note}]
  deductions            Json
  employerContributions Json     @map("employer_contributions")
  grossSalary           Decimal  @map("gross_salary") @db.Decimal(12, 3)
  totalDeductions       Decimal  @map("total_deductions") @db.Decimal(12, 3)
  netSalary             Decimal  @map("net_salary") @db.Decimal(12, 3)
  createdAt             DateTime @default(now()) @map("created_at")

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id])
  contract Contract   @relation(fields: [contractId], references: [id])

  @@unique([runId, employeeId])
  @@map("payslips")
}

// ─────────── Settings ───────────

model Setting {
  key       String   @id @db.VarChar(50)
  value     String   @db.VarChar(1000)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ─────────── Notifications ───────────

model Notification {
  id        Int       @id @default(autoincrement()) @map("notification_id")
  userId    Int       @map("user_id")
  type      String    @db.VarChar(40)                     // leave, request, payslip, announcement, expiry
  title     String    @db.VarChar(150)
  body      String?   @db.VarChar(500)
  link      String?   @db.VarChar(255)                    // frontend route, e.g. /leave/requests/12
  dedupeKey String?   @unique @map("dedupe_key") @db.VarChar(120) // stops the same alert being sent twice
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

// ─────────── Employee requests & letters ───────────

model RequestType {
  id                 Int     @id @default(autoincrement()) @map("request_type_id")
  code               String  @unique @db.VarChar(30)     // SALARY_CERT, NOC...
  name               String  @db.VarChar(100)
  description        String? @db.VarChar(255)
  category           String  @db.VarChar(10)             // letter (PDF generated) | general
  template           String? @db.Text                    // letter body with {{placeholders}}
  requiresAttachment Boolean @default(false) @map("requires_attachment")
  active             Boolean @default(true)

  requests EmployeeRequest[]

  @@map("request_types")
}

model EmployeeRequest {
  id               Int       @id @default(autoincrement()) @map("request_id")
  employeeId       Int       @map("employee_id")
  typeId           Int       @map("type_id")
  purpose          String    @db.VarChar(255)
  details          String?   @db.Text
  addressedTo      String?   @map("addressed_to") @db.VarChar(150)  // e.g. "Ministry of Interior", "BBK"
  attachmentId     Int?      @map("attachment_id")
  status           String    @default("pending") @db.VarChar(20)    // pending | in_progress | approved | rejected | completed | cancelled
  handledByUserId  Int?      @map("handled_by_user_id")
  decisionComment  String?   @map("decision_comment") @db.VarChar(500)
  resultDocumentId Int?      @map("result_document_id")             // generated letter
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  employee       Employee    @relation(fields: [employeeId], references: [id])
  type           RequestType @relation(fields: [typeId], references: [id])
  attachment     Document?   @relation("RequestAttachment", fields: [attachmentId], references: [id])
  resultDocument Document?   @relation("RequestResult", fields: [resultDocumentId], references: [id])

  @@index([employeeId, status])
  @@index([status])
  @@map("employee_requests")
}

// ─────────── Announcements ───────────

model Announcement {
  id                   Int       @id @default(autoincrement()) @map("announcement_id")
  title                String    @db.VarChar(150)
  body                 String    @db.Text
  priority             String    @default("normal") @db.VarChar(10) // normal | important | urgent
  pinned               Boolean   @default(false)
  audience             String    @default("all") @db.VarChar(15)    // all | departments | employees
  departmentIds        Json?     @map("department_ids")
  employeeIds          Json?     @map("employee_ids")
  publishAt            DateTime  @default(now()) @map("publish_at")
  expiresAt            DateTime? @map("expires_at")
  attachmentName       String?   @map("attachment_name") @db.VarChar(255)
  attachmentStoredName String?   @map("attachment_stored_name") @db.VarChar(100)
  attachmentMime       String?   @map("attachment_mime") @db.VarChar(50)
  notified             Boolean   @default(false)                     // notifications sent once published
  createdByUserId      Int       @map("created_by_user_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([publishAt])
  @@map("announcements")
}