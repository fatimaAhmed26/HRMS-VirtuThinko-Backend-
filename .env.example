# Copy to .env and fill in. Never commit .env.
DATABASE_URL="mysql://root:PASSWORD@localhost:3306/hrms"

# Long random secrets, at least 32 characters each, and different from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 64 hex characters (encrypts bank account numbers). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

PORT=5000
# 127.0.0.1 = only this computer can reach the API (recommended). Use 0.0.0.0 only behind a proxy when deployed.
HOST=127.0.0.1
# The React app (the only website allowed to call the API from a browser)
CLIENT_URL=http://localhost:5173

COMPANY_NAME=
COMPANY_ADDRESS=

# Document scanner (optional): reads ID cards and passports with AI. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
